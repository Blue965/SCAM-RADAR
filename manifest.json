{
  "manifest_version": 3,
  "name": "ScamRadar - Threat & Scam Shield",
  "version": "1.2",
  "description": "Protection en temps réel contre les sites frauduleux, le phishing et les arnaques.",
  "permissions": ["activeTab", "storage", "tabs", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamRadar",
    "default_icon": {
      "16": "scamradar-icon-v2.svg",
      "48": "scamradar-icon-v2.svg",
      "128": "scamradar-icon-v2.svg"
    }
  },
  "icons": {
    "16": "scamradar-icon-v2.svg",
    "48": "scamradar-icon-v2.svg",
    "128": "scamradar-icon-v2.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}